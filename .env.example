# Пример конфигурации. Скопируйте в .env и поправьте под себя.
# Файл .env в git не попадает (см. .gitignore).

# --- Общие -----------------------------------------------------------------
# Куда складывать результаты (по умолчанию <корень проекта>/output)
LEC2TEXT_OUTPUT_DIR=
# Где создавать временные папки (пусто -> системная temp)
LEC2TEXT_TEMP_DIR=
# Сохранять скачанное аудио в output_dir (true) или использовать временную папку (false)
LEC2TEXT_KEEP_AUDIO=true
# Подробный лог yt-dlp
LEC2TEXT_VERBOSE=false

# --- Downloader ------------------------------------------------------------
# Порядок YouTube-клиентов для фолбэка при 403 (через запятую)
LEC2TEXT_PLAYER_CLIENTS=default,android_vr,web_safari,mweb
# Cookies из браузера (сильно помогает от бот-проверки).
# Примеры: firefox | chrome | "chrome:Profile 1" | chromium
LEC2TEXT_COOKIES_FROM_BROWSER=
# Либо путь к cookies.txt в формате Netscape
LEC2TEXT_COOKIES_FILE=
# Подмена TLS-отпечатка (нужен пакет curl_cffi): chrome | firefox | safari
LEC2TEXT_IMPERSONATE=chrome
# Прокси, если YouTube блокирует ваш IP: socks5://127.0.0.1:1080
LEC2TEXT_PROXY=
LEC2TEXT_RETRIES=10
LEC2TEXT_FRAGMENT_RETRIES=10
LEC2TEXT_SOCKET_TIMEOUT=30
LEC2TEXT_SLEEP_INTERVAL=1.0
LEC2TEXT_MAX_SLEEP_INTERVAL=5.0
LEC2TEXT_FORCE_IPV4=true
# Файл-архив уже скачанных video_id (не качать повторно)
LEC2TEXT_DOWNLOAD_ARCHIVE=
# Кэш yt-dlp
LEC2TEXT_CACHE_DIR=
# Путь к ffmpeg, если он не в PATH
LEC2TEXT_FFMPEG_LOCATION=
# Путь к deno (обычно находится в PATH автоматически)
LEC2TEXT_JS_RUNTIME=
# Внешние JS-скрипты для YouTube
LEC2TEXT_REMOTE_COMPONENTS=ejs:github

# --- Аудио для ASR ---------------------------------------------------------
LEC2TEXT_ASR_SAMPLE_RATE=16000
LEC2TEXT_ASR_CHANNELS=1
LEC2TEXT_ASR_FORMAT=wav

# --- Токены для ASR (используются на следующих фазах) ----------------------
HF_TOKEN=
GROQ_API_KEY=

# --- ASR API ---------------------------------------------------------------
LEC2TEXT_GROQ_BASE_URL=https://api.groq.com/openai/v1
LEC2TEXT_ASR_MODEL=whisper-large-v3-turbo
LEC2TEXT_ASR_LANGUAGE= # оставьте пустым для автоопределения
LEC2TEXT_CHUNK_SECONDS=1200
LEC2TEXT_CHUNK_BITRATE=48k
LEC2TEXT_CHUNK_OVERLAP=1.0
LEC2TEXT_REQUEST_TIMEOUT=300
